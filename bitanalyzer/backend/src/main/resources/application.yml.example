spring:
  application:
    name: bitanalyzer

  profiles:
    active: dev

  # ==================== 공통 설정 ====================
  datasource:
    driver-class-name: org.postgresql.Driver

  jpa:
    show-sql: true
    properties:
      hibernate:
        format_sql: true
        dialect: org.hibernate.dialect.PostgreSQLDialect

  thymeleaf:
    cache: false
    check-template-location: true

  devtools:
    livereload:
      enabled: true

  # OpenFeign 설정
  cloud:
    openfeign:
      client:
        config:
          default:
            connect-timeout: 5000
            read-timeout: 10000
            logger-level: basic

server:
  port: 8080
  compression:
    enabled: true

management:
  endpoints:
    web:
      exposure:
        include: health, info, metrics, prometheus
  endpoint:
    health:
      show-details: always
  info:
    env:
      enabled: true

logging:
  level:
    com.bitanalyzer: DEBUG
    org.springframework.web.socket: DEBUG
    org.springframework.cloud.openfeign: DEBUG
    org.hibernate.SQL: DEBUG
    org.hibernate.type.descriptor.sql.BasicBinder: TRACE


# ==================== dev profile ====================
---
spring:
  config:
    activate:
      on-profile: dev

  datasource:
    url: jdbc:postgresql://localhost:5432/xxxxxxx
    username:
    password:

  jpa:
    hibernate:
      ddl-auto: create-drop
  sql:
    init:
      mode: always # 필요하면 켜고, 처음엔 꺼도 됨

logging:
  level:
    com.bitanalyzer: DEBUG
    org.springframework.security: TRACE
    org.hibernate.SQL: DEBUG

bithumb:
  access-key:
  secret-key:


# ==================== prod profile ====================
---
spring:
  config:
    activate:
      on-profile: prod

  datasource:
    url: jdbc:postgresql://localhost:5432/xxxxxxx
    username:
    password:
#    password: ${DB_PASSWORD:postgres}

  jpa:
    hibernate:
      ddl-auto: validate

  thymeleaf:
    cache: true

logging:
  level:
    com.bitanalyzer: INFO
    org.springframework.security: WARN
    org.hibernate.SQL: ERROR
